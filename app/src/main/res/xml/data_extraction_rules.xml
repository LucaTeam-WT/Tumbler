<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for Android 12 (API 31) and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.

   LucaAuth excludes all app data from both cloud backup and device-to-device
   transfer. Secrets are encrypted with an Android Keystore key that never leaves the
   device, so restored or transferred data could not be decrypted. On API 31+,
   android:allowBackup="false" does not stop device-to-device transfer; these rules do.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
